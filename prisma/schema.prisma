
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  AZURE
}

enum ValidationStatus {
  VALID
  INVALID
  ERROR
}

enum ActionKind {
  WORK_ITEM_COMMENT
  WORK_ITEM_UPDATE_FIELDS
  WORK_ITEM_TRANSITION_STATE
  WORK_ITEM_LINK_PR
  WORK_ITEM_CLOSE_AFTER_MERGE
  WORK_ITEM_EDIT_TEXT
  WORK_ITEM_SET_CATEGORY
  WORK_ITEM_ADD_TAGS
  PIPELINE_QUEUE_RUN
  BUILD_RETRY_STAGE
  BUILD_CANCEL
}

enum ActionStatus {
  PENDING
  APPROVED
  EXECUTING
  SUCCEEDED
  FAILED
  REJECTED
  EXPIRED
}

enum ActionSource {
  RECOMMENDATION
  USER
  /// A fix suggested by the user's AI SOP check.
  AI_SUGGESTION
}

enum SopAiStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum TriageStatus {
  SNOOZED
  ACKNOWLEDGED
  ABANDONED
}

enum AuditEvent {
  PROPOSED
  APPROVED
  REJECTED
  EXPIRED
  EXECUTION_STARTED
  EXECUTION_SUCCEEDED
  EXECUTION_FAILED
}

model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  password             String
  credentials          Credential[]
  actions              ProposedAction[]
  auditLogs            AuditLog[]
  triageMarks          TriageMark[]
  aiCredentials        AiCredential[]
  aiPreference         AiPreference?
  aiUsage              AiUsage[]
  userRulebooks        UserRulebook[]
  sopAiChecks          SopAiCheck[]
  sopProjectExclusions SopProjectExclusion[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Credential {
  id                   String            @id @default(uuid())
  platform             Platform
  organizationUrl      String
  label                String?
  encryptedPatToken    String
  lastValidatedAt      DateTime?
  lastValidationStatus ValidationStatus?
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actions              ProposedAction[]
  triageMarks          TriageMark[]
  sopAiChecks          SopAiCheck[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([userId, platform, organizationUrl])
}

/// A change proposed for Azure DevOps. Nothing is written until a human
/// approves it; params are immutable and bound to payloadHash.
model ProposedAction {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kept (as null) when the credential is deleted so history survives.
  credentialId    String?
  credential      Credential?  @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  organizationUrl String
  projectId       String
  kind            ActionKind
  source          ActionSource
  target          Json
  params          Json
  preview         Json
  summary         String
  payloadHash     String
  baseRev         Int?
  status          ActionStatus @default(PENDING)
  expiresAt       DateTime
  decidedAt       DateTime?
  executedAt      DateTime?
  result          Json?
  errorCode       String?
  errorMessage    String?
  auditLogs       AuditLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, status])
  @@index([credentialId, kind, status])
}

/// Append-only. Never stores PATs or raw Azure error bodies.
model AuditLog {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionId  String?
  action    ProposedAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  event     AuditEvent
  metadata  Json
  ipAddress String?
  userAgent String?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([actionId])
}

/// Personal dashboard triage (snooze / acknowledge / abandon). Cockpit-only:
/// never written to Azure DevOps.
model TriageMark {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String
  credential   Credential   @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  /// wi:<id>, pr:<repositoryId>:<id>, pipeline:<project>:<definitionId>:<branch> or project:<name>.
  itemKey      String
  status       TriageStatus
  snoozedUntil DateTime?
  /// Signal codes present when marked; a code not in this list resurfaces the item.
  signals      String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([credentialId, itemKey])
  @@index([userId, credentialId])
}

enum AiProvider {
  CLAUDE
  OPENROUTER
  /// OpenCode pay-as-you-go gateway (opencode.ai).
  OPENCODE
}

enum AiEffort {
  LOW
  MEDIUM
  HIGH
}

/// A user's own AI provider key. One per provider per user; never returned to clients.
model AiCredential {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             AiProvider
  label                String?
  encryptedApiKey      String
  /// Last 4 characters, shown so users can recognise the key.
  keyHint              String
  lastValidatedAt      DateTime?
  lastValidationStatus ValidationStatus?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([userId, provider])
}

/// Which provider/model/effort a user's AI checks run with, and their spend guard.
model AiPreference {
  userId                   String      @id
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                 AiProvider?
  model                    String?
  effort                   AiEffort    @default(MEDIUM)
  dailyLimitUsd            Float       @default(2)
  /// Required before a model whose providers may store or train on prompts is used.
  dataCollectionAcceptedAt DateTime?
  updatedAt                DateTime    @updatedAt
}

/// One row per AI call, for the daily spend guard and usage display.
model AiUsage {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         AiProvider
  model            String
  purpose          String
  inputTokens      Int        @default(0)
  outputTokens     Int        @default(0)
  cacheReadTokens  Int        @default(0)
  cacheWriteTokens Int        @default(0)
  costUsd          Float      @default(0)
  createdAt        DateTime   @default(now())

  @@index([userId, createdAt])
}

/// Organization-wide settings edited by SOP owners (SOP_ADMIN_EMAILS).
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Versions of the organization's default SOP rulebook. The latest version is active;
/// restoring an old version saves it again as a new version.
model Rulebook {
  version   Int      @id
  content   String
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

/// How one Azure DevOps project maps onto the SOP (stages, fields, categories...).
/// Shared: anyone may set a project up or change it; every change is kept in SopProjectChange.
/// Matched by project name (case-insensitive), as project facts always were.
model SopProject {
  id          String                @id @default(uuid())
  /// Lower-cased project name; the lookup key.
  nameKey     String                @unique
  projectName String
  /// Validated project settings (see project-settings.ts).
  settings    Json
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  changes     SopProjectChange[]
  exclusions  SopProjectExclusion[]
}

enum SopProjectChangeKind {
  CREATED
  UPDATED
  REMOVED
  IMPORTED
}

/// History of project set-ups: who changed what, when (kept after a set-up is removed).
model SopProjectChange {
  id           String               @id @default(uuid())
  sopProjectId String?
  sopProject   SopProject?          @relation(fields: [sopProjectId], references: [id], onDelete: SetNull)
  projectName  String
  kind         SopProjectChangeKind
  settings     Json?
  changedBy    String?
  createdAt    DateTime             @default(now())

  @@index([projectName, createdAt])
}

/// Projects a user switched SOP checks off for (all set-up projects are on by default).
model SopProjectExclusion {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sopProjectId String
  sopProject   SopProject @relation(fields: [sopProjectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, sopProjectId])
}

/// Versions of one user's personal rule file (overrides + MY- rules). Latest is active.
model UserRulebook {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  content   String
  createdAt DateTime @default(now())

  @@unique([userId, version])
}

/// The latest AI check of one ticket for one user. Private to that user; re-run only when its input changes.
model SopAiCheck {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String
  credential   Credential  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  workItemId   Int
  projectName  String
  /// Ticket revision, rules versions and model settings; unchanged = no new AI call.
  inputHash    String
  status       SopAiStatus @default(QUEUED)
  /// Verified verdicts: [{ ruleId, ruleTitle, verdict, reason, quotes, fix }].
  results      Json?
  /// Why the check failed or was skipped (AI_KEY_INVALID, DAILY_LIMIT_REACHED, ...).
  errorReason  String?
  /// What the AI provider itself said about the failure or limit (shown to the user).
  errorDetail  String?
  provider     AiProvider?
  model        String?
  costUsd      Float?
  /// Rate-limited checks wait until this time.
  notBefore    DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, credentialId, workItemId])
  @@index([status, notBefore])
}
